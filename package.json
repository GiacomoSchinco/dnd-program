{
  "name": "dnd-combat-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:preview": "vite build && electron .",
    "electron:package": "vite build && electron-packager . \"D&D Combat Tracker\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=^\\/src --ignore=^\\/node_modules --ignore=^\\/\\.git --ignore=^\\/release",
    "electron:build": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.giaco.dndcombattracker",
    "productName": "D&D Combat Tracker",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
