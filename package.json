{
  "name": "castle-keeper",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "description": "Castle Keeper — Your D&D Adventure Hub",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "version:bump": "npm version patch --no-git-tag-version",
    "electron:dev": "vite & electron .",
    "clean:release": "rimraf release",
    "electron:build": "npm run clean:release && npm version patch --no-git-tag-version && vite build && electron-builder",
    "electron:build:portable": "npm run clean:release && npm version patch --no-git-tag-version && vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.castlekeeper.app",
    "productName": "Castle Keeper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "icon": "public/logo.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/logo.icns",
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "daisyui": "^5.5.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
